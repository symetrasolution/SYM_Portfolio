# --- API server (server/index.ts, `npm run dev:server`) ---
# Port the API listens on (Vite dev proxies /api here).
PORT="4000"

# Strict CORS: comma-separated origins allowed to call /api.
# Production: set to your public site origin, e.g. https://symetra.example.com
ALLOWED_ORIGIN="http://localhost:3000"

# Trust proxy hops for correct client IPs behind Nginx/Caddy.
# Leave unset for direct exposure; set TRUST_PROXY=1 behind one proxy.
# TRUST_PROXY="1"

# Where inquiries.json is stored (gitignored — contains personal data).
DATA_DIR="./data"

# Inquiry rate limit (per IP): max requests per window.
INQUIRY_RATE_LIMIT_MAX="10"
INQUIRY_RATE_LIMIT_WINDOW_MS="60000"

# --- Inquiry notifications (email is the primary delivery) ---
# If SMTP_HOST/INQUIRY_TO are missing, inquiries are still saved and the
# missing config is logged — the user always sees success.
SMTP_HOST="mail.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="inquiries@example.com"
SMTP_PASS="CHANGEME"
INQUIRY_TO="sales@example.com"
INQUIRY_FROM="inquiries@example.com"

# WhatsApp hook — stubbed (logged only) until a provider is wired.
# WHATSAPP_WEBHOOK_URL=""

# --- AI Studio legacy (unused by this project) ---
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
